{
  "name": "npmdex",
  "description": "A faster, smarter search engine for npm packages with better discovery than npmjs.com.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build packages/*/tsconfig.json",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "format": "prettier --check 'packages/*/src/**/*.{ts,tsx,css}'",
    "format:fix": "prettier --write 'packages/*/src/**/*.{ts,tsx,css}'"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
